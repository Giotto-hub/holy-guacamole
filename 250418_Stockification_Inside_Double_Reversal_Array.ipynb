from twelvedata import TDClient
import pandas as pd
import numpy as np

# Initialize client
td = TDClient(apikey="88281522a9fa4f098c77f33cff29c1ec")

symbols = ["AAOI", "CPRX", "SAP", "AAPL", "MSFT", "GOOGL", "TSLA"]
match_inside = []
match_double_inside = []
match_bull_rev = []
match_bear_rev = []
keltner_pullback_short = []
keltner_pullback_long = []

def calculate_ema(data, period):
    return data.ewm(span=period, adjust=False).mean()

def calculate_atr(high, low, close, period):
    tr = np.maximum(high - low, np.abs(high - close.shift(1)), np.abs(low - close.shift(1)))
    return tr.rolling(window=period).mean()

def calculate_keltner_channel(df, ema_period=10, atr_period=10, multiplier=2):
    df['ema'] = calculate_ema(df['close'], ema_period)
    df['atr'] = calculate_atr(df['high'], df['low'], df['close'], atr_period)
    df['upper_kc'] = df['ema'] + (multiplier * df['atr'])
    df['lower_kc'] = df['ema'] - (multiplier * df['atr'])
    return df

# Loop über alle Symbole
for symbol in symbols:
    print(f"\n🔎 Analyse für {symbol}:")

    try:
        ts = td.time_series(
            symbol=symbol,
            interval="1day",
            outputsize=20,  # Erhöht für genauere Berechnung des Keltner Channels
            date="yesterday+1",
            timezone="Europe/Berlin",
        )
        df = ts.as_pandas().sort_index()

        if len(df) < 20:
            print("❌ Nicht genug Daten für Analyse.")
            continue

        df = calculate_keltner_channel(df)

        curr = df.iloc[-1]
        prev = df.iloc[-2]
        prev2 = df.iloc[-3]

        # Inside Bar prüfen
        if curr['high'] < prev['high'] and curr['low'] > prev['low']:
            print("✅ Letzte Kerze ist eine Inside Bar.")
            match_inside.append(symbol)
        else:
            print("🔍 Keine Inside Bar bei der letzten Kerze erkannt.")

        # Double Inside Bar prüfen
        if (
            curr['high'] < prev['high'] and curr['low'] > prev['low'] and
            prev['high'] < prev2['high'] and prev['low'] > prev2['low']
        ):
            print("✅ Letzte Kerze ist eine Double Inside Bar.")
            match_double_inside.append(symbol)
        else:
            print("🔍 Keine Double Inside Bar bei der letzten Kerze erkannt.")

        # Bullish Reversal prüfen
        if (
            prev['close'] < prev['open'] and
            curr['close'] > curr['open'] and
            curr['open'] < prev['close'] and
            curr['close'] > prev['open']
        ):
            print("✅ Letzte Kerze ist ein Bullish Reversal.")
            match_bull_rev.append(symbol)
        else:
            print("🔍 Keine Bullish Reversal bei der letzten Kerze erkannt.")

        # Bearish Reversal prüfen
        if (
            prev['close'] > prev['open'] and
            curr['close'] < curr['open'] and
            curr['open'] > prev['close'] and
            curr['close'] < prev['open']
        ):
            print("✅ Letzte Kerze ist ein Bearish Reversal.")
            match_bear_rev.append(symbol)
        else:
            print("🔍 Keine Bearish Reversal bei der letzten Kerze erkannt.")

        # Keltner Channel Pullback SHORT prüfen
        if prev['high'] > prev['upper_kc'] and curr['close'] < curr['upper_kc'] and curr['close'] > curr['lower_kc']:
            print("✅ Keltner Pullback SHORT erkannt.")
            keltner_pullback_short.append(symbol)
        else:
            print("🔍 Kein Keltner Pullback SHORT erkannt.")

        # Keltner Channel Pullback LONG prüfen
        if prev['low'] < prev['lower_kc'] and curr['close'] > curr['lower_kc'] and curr['close'] < curr['upper_kc']:
            print("✅ Keltner Pullback LONG erkannt.")
            keltner_pullback_long.append(symbol)
        else:
            print("🔍 Kein Keltner Pullback LONG erkannt.")

    except Exception as e:
        print(f"⚠️ Fehler bei Symbol {symbol}: {e}")
        continue

print("\n📊 Zusammenfassung:")
print(f"Inside Bars: {match_inside}")
print(f"Double Inside Bars: {match_double_inside}")
print(f"Bullish Reversals: {match_bull_rev}")
print(f"Bearish Reversals: {match_bear_rev}")
print(f"Keltner Pullback SHORT: {keltner_pullback_short}")
print(f"Keltner Pullback LONG: {keltner_pullback_long}")
